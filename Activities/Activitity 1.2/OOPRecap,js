class User {
    #id;

    constructor(name, id) {
        this.name = name;
        this.#id = id;
    }

    getName() {
        return this.name;
    }

    getRole() {
        return "User";
    }

    getId() {
        return this.#id;
    }
}

class Student extends User {
    constructor(name, id, course) {
        super(name, id);
        this.course = course;
    }

    getCourse() {
        return this.course;
    }

    getRole() {
        return "Student";
    }
}

class Teacher extends Student {
    getRole() {
        return "Teacher";
    }
}

class Admin extends User {
    getRole() {
        return "Admin";
    }
}

